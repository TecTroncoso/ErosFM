# Puerto en el que corre el servidor de radio
PORT=3000

# Configuración de Hugging Face
HF_USER=tu_usuario_de_huggingface
HF_DATASET=tu_dataset_privado
HF_TOKEN=hf_tu_token_de_lectura

# Opcional: Ruta absoluta al ejecutable de FFmpeg en tu sistema local
# (Si FFmpeg está en tu PATH global, dejá esto vacío)
FFMPEG_PATH=
